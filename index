dius: 999px;\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      pointer-events: none;\n    }\n    .demo-chip .dot {\n      width: 6px; height: 6px;\n      background: var(--green);\n      border-radius: 50%;\n      animation: pulseDot 1.5s infinite;\n    }\n    @keyframes pulseDot {\n      0%, 100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5); }\n      50% { box-shadow: 0 0 0 6px rgba(22, 163, 74, 0); }\n    }\n\n    @media (max-width: 1100px) {\n      .pitch-grid, .personas-grid { grid-template-columns: 1fr 1fr; }\n      .section { padding: 40px 32px; }\n      .split-section .split-content { grid-template-columns: 1fr; gap: 24px; }\n      .split-section .split-art { display: none; }\n      .win-grid { grid-template-columns: 1fr; }\n    }\n    @media (max-width: 720px) {\n      .pitch-grid, .personas-grid { grid-template-columns: 1fr; }\n    }\n\n    /* ============ SPLIT-LAYOUT SLIDES (problem / solution) ============ */\n    .split-section .split-content {\n      flex: 1;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 48px;\n      align-items: center;\n      max-width: 1500px;\n      width: 100%;\n      margin: 0 auto;\n      min-height: 0;\n    }\n    .split-section.solution .split-content {\n      grid-template-columns: 1fr 1.05fr;\n      max-height: 500px;\n      align-self: center;\n      margin-top: 0;\n    }\n    .solution-head {\n      max-width: 1500px;\n      width: 100%;\n      margin: 0 auto;\n      display: flex;\n      flex-direction: column;\n      gap: 14px;\n      margin-bottom: 0;\n      padding-top: 40px;\n    }\n    .split-text { display: flex; flex-direction: column; gap: 22px; min-width: 0; }\n    .split-text.problem-text {\n      justify-content: center;\n      gap: 28px;\n    }\n    .slide-eyebrow {\n      font-family: var(--font-mono);\n      font-size: 12px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--text-faint);\n      display: inline-flex;\n      align-items: center;\n      gap: 14px;\n    }\n    .slide-eyebrow .num {\n      display: inline-flex; align-items: center; justify-content: center;\n      width: 28px; height: 28px;\n      background: var(--text);\n      color: var(--bg);\n      border-radius: 50%;\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 13px;\n      letter-spacing: 0;\n    }\n    .slide-eyebrow.pink .num { background: var(--pink); }\n    .slide-eyebrow.lavender .num { background: var(--lavender); }\n    .slide-eyebrow.green .num { background: var(--green); }\n\n    .slide-title {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: clamp(46px, 4.8vw, 76px);\n      letter-spacing: -0.035em;\n      line-height: 0.95;\n      margin: 0;\n      text-wrap: balance;\n    }\n    .slide-title em {\n      font-family: var(--font-serif);\n      font-weight: 400;\n      font-style: italic;\n      color: var(--lavender);\n    }\n    .slide-sub {\n      font-size: 19px;\n      color: var(--text-dim);\n      line-height: 1.5;\n      margin: 0;\n      max-width: 580px;\n      text-wrap: pretty;\n    }\n    .slide-body { font-size: 17px; color: var(--text-dim); line-height: 1.55; margin: 0; max-width: 560px; }\n    .slide-body strong { color: var(--text); font-weight: 600; }\n\n    /* Problem slide art */\n    .split-art {\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      width: 100%;\n      height: 100%;\n      min-height: 0;\n    }\n    .split-art img {\n      max-width: 100%;\n      max-height: 78vh;\n      width: auto;\n      height: auto;\n      object-fit: contain;\n      display: block;\n    }\n    .split-art.solution img {\n      max-height: 70vh;\n      border-radius: 22px;\n      box-shadow: 0 32px 80px -24px rgba(20, 16, 28, 0.25), 0 4px 12px rgba(20, 16, 28, 0.06);\n      border: 1px solid var(--border);\n    }\n\n    /* Big fragment chip wall on problem slide */\n    .frag-wall {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      margin-top: 8px;\n    }\n    .frag-wall .frag-chip {\n      font-family: var(--font-mono);\n      font-size: 14px;\n      background: var(--bg-elev);\n      color: var(--text-dim);\n      padding: 8px 14px;\n      border-radius: 999px;\n      text-decoration: line-through;\n      text-decoration-color: rgba(233, 30, 99, 0.55);\n      text-decoration-thickness: 1.8px;\n    }\n\n    /* Solution feature list (bigger pillars) */\n    .feature-list {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .feature-list li {\n      background: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 18px;\n      padding: 18px 22px;\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      transition: transform 0.15s, box-shadow 0.15s;\n    }\n    .feature-list li:hover { transform: translateX(4px); box-shadow: 0 14px 32px -14px rgba(20, 16, 28, 0.12); }\n    .feature-list .feat-num {\n      width: 38px; height: 38px;\n      border-radius: 12px;\n      display: grid; place-items: center;\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 16px;\n      flex-shrink: 0;\n    }\n    .feature-list li:nth-child(1) .feat-num { background: rgba(139, 92, 246, 0.14); color: var(--lavender); }\n    .feature-list li:nth-child(2) .feat-num { background: rgba(233, 30, 99, 0.1); color: var(--pink); }\n    .feature-list li:nth-child(3) .feat-num { background: rgba(245, 197, 24, 0.18); color: #B45309; }\n    .feature-list .feat-body { min-width: 0; }\n    .feature-list .feat-title {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 22px;\n      letter-spacing: -0.02em;\n      color: var(--text);\n      line-height: 1.1;\n      margin: 0 0 3px;\n    }\n    .feature-list .feat-desc {\n      font-size: 13.5px;\n      color: var(--text-dim);\n      line-height: 1.45;\n      margin: 0;\n    }\n    .organizer-note {\n      background: var(--bg-elev);\n      border-left: 3px solid var(--green);\n      padding: 12px 16px;\n      border-radius: 0 12px 12px 0;\n      font-size: 14px;\n      color: var(--text-dim);\n      margin-top: 8px;\n    }\n    .organizer-note strong { color: var(--text); font-weight: 700; }\n\n    /* ============ WIN slide ============ */\n    .win-grid {\n      flex: 1;\n      display: grid;\n      grid-template-columns: 0.85fr 1.6fr;\n      gap: 36px;\n      margin: 22px auto 0;\n      min-height: 0;\n      width: 100%;\n      max-width: 1500px;\n      max-height: 600px;\n      align-self: center;\n      align-items: stretch;\n    }\n    .win-card {\n      background: transparent;\n      border: none;\n      border-radius: 0;\n      padding: 0 8px;\n      display: flex;\n      flex-direction: column;\n      gap: 18px;\n      position: relative;\n      overflow: hidden;\n      min-width: 0;\n      height: 100%;\n      justify-content: flex-start;\n    }\n    .win-card::before { display: none; }\n    .win-card.market::before { background: var(--green); }\n    .win-card.market h3 {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 36px;\n      letter-spacing: -0.028em;\n      line-height: 0.96;\n      margin: 0;\n      color: var(--text);\n    }\n    .win-card.market .hero-stat .big {\n      font-size: clamp(96px, 8.5vw, 140px);\n      letter-spacing: -0.045em;\n      line-height: 0.86;\n      color: var(--green);\n    }\n    .win-card.market .hero-stat .big-sub {\n      font-size: 18px;\n      margin-top: 10px;\n      color: var(--text-dim);\n    }\n    .win-card.market .stat-row .stat .num {\n      font-size: 34px;\n      min-width: 130px;\n    }\n    .win-card.market .stat-row .stat .lbl {\n      font-size: 16px;\n    }\n\n    /* Right-side image — no frame, natural aspect ratio, centered */\n    .win-map-frame {\n      