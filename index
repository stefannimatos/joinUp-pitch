    <p class=\"persona-profile\">\n        Runs a <strong>local cultural association<\u002Fstrong> and wants more people to discover and attend his events.\n      <\u002Fp>\n      <div class=\"persona-wants\">\n        <div class=\"wants-label\">What he wants<\u002Fdiv>\n        <div class=\"want-row\"><span class=\"bullet\"><\u002Fspan> Reach the right audience<\u002Fdiv>\n        <div class=\"want-row\"><span class=\"bullet\"><\u002Fspan> Increase ticket sales<\u002Fdiv>\n        <div class=\"want-row\"><span class=\"bullet\"><\u002Fspan> Build a long-term community<\u002Fdiv>\n      <\u002Fdiv>\n      <div class=\"persona-pain\">\n        <span class=\"pain-pill\">Limited reach<\u002Fspan>\n        <span class=\"pain-pill\">No analytics<\u002Fspan>\n        <span class=\"pain-pill\">Hard to retarget<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div class=\"scroll-hint\">\n    <span>Scroll · Try the product<\u002Fspan>\n    <div class=\"arrow\"><\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- ============ SLIDE 5: LIVE DEMO ============ -->\n<section class=\"section demo\" id=\"s5\">\n  <div class=\"demo-chip\"><span class=\"dot\"><\u002Fspan> Live interactive demo<\u002Fdiv>\n  <iframe class=\"demo-frame\" id=\"demo-frame\" title=\"JoinUp live demo\"><\u002Fiframe>\n<\u002Fsection>\n\n<script>\n  // scroll nav active state\n  const dots = document.querySelectorAll(\".scroll-nav a\");\n  const sections = document.querySelectorAll(\".section\");\n  const io = new IntersectionObserver((entries) => {\n    entries.forEach((e) => {\n      if (e.isIntersecting && e.intersectionRatio > 0.5) {\n        const id = e.target.id;\n        dots.forEach((d) => d.classList.toggle(\"active\", d.getAttribute(\"href\") === \"#\" + id));\n        document.body.setAttribute(\"data-active\", id);\n      }\n    });\n  }, { threshold: [0.5] });\n  sections.forEach((s) => io.observe(s));\n\n  // Align the left market card's top with the right image's top.\n  // The right image keeps its natural 16:9 aspect ratio so its top is\n  // vertically offset from the grid row. Mirror that offset on the left.\n  function alignWinCard() {\n    const img = document.querySelector(\".win-map-frame img\");\n    const leftCard = document.querySelector(\".win-card.market\");\n    const rightFrame = document.querySelector(\".win-map-frame\");\n    if (!img || !leftCard || !rightFrame || !img.complete) return;\n    const imgRect = img.getBoundingClientRect();\n    const frameRect = rightFrame.getBoundingClientRect();\n    const offset = Math.max(0, imgRect.top - frameRect.top);\n    leftCard.style.paddingTop = offset + \"px\";\n    leftCard.style.paddingBottom = offset + \"px\";\n  }\n  window.addEventListener(\"load\", alignWinCard);\n  window.addEventListener(\"resize\", alignWinCard);\n  const winImg = document.querySelector(\".win-map-frame img\");\n  if (winImg) {\n    if (winImg.complete) alignWinCard();\n    else winImg.addEventListener(\"load\", alignWinCard);\n  }\n<\u002Fscript>\n\n<script>\n  // Bundled mode: swap persona avatar srcs and iframe src to blob URLs\n  (function () {\n    var R = window.__resources || {};\n    document.querySelectorAll(\"[data-persona-id]\").forEach(function (el) {\n      var id = el.getAttribute(\"data-persona-id\");\n      if (R[\"persona_\" + id]) el.src = R[\"persona_\" + id];\n      else el.src = \"https://images.unsplash.com/photo-\" + id + \"?w=300&q=80&auto=format&fit=crop\";\n    });\n    var f = document.getElementById(\"demo-frame\");\n    if (f) f.src = (R.demoHtml) ? R.demoHtml : \"index.html\";\n  })();\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
