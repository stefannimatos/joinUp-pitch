rl(\"6e3d5b5c-5f22-4213-8925-72a9be3727fb\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Instrument Serif';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"61eb8e23-b16c-4be2-9d51-1e3a1d47faab\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Instrument Serif';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"68ad3432-05df-410e-bf5e-cc1d832c3c8c\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n  <style>\n    :root {\n      --bg: #FAFAF7;\n      --bg-elev: #F3F0E8;\n      --bg-card: #FFFFFF;\n      --border: #E8E3D6;\n      --text: #18181B;\n      --text-dim: #6B6671;\n      --text-faint: #A29D99;\n      --lavender: #8B5CF6;\n      --lavender-deep: #6D28D9;\n      --yellow: #F5C518;\n      --pink: #E91E63;\n      --green: #16A34A;\n      --cyan: #0891B2;\n      --font-display: \"Bricolage Grotesque\", system-ui, sans-serif;\n      --font-body: \"Geist\", system-ui, sans-serif;\n      --font-mono: \"Geist Mono\", ui-monospace, monospace;\n      --font-serif: \"Instrument Serif\", Georgia, serif;\n    }\n    * { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); font-family: var(--font-body); -webkit-font-smoothing: antialiased; }\n    html { scroll-snap-type: y mandatory; scroll-behavior: smooth; }\n    body { overflow-x: hidden; }\n\n    /* Section base */\n    .section {\n      height: 100vh;\n      min-height: 0;\n      width: 100%;\n      scroll-snap-align: start;\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      padding: 32px 56px 56px;\n      overflow: hidden;\n    }\n    .section.demo { padding: 0; min-height: 100vh; }\n\n    /* Logo */\n    .deck-logo {\n      position: fixed;\n      top: 22px;\n      left: 28px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 22px;\n      letter-spacing: -0.02em;\n      z-index: 50;\n      color: var(--text);\n      transition: opacity 0.3s;\n    }\n    body[data-active=\"s5\"] .deck-logo { opacity: 0; pointer-events: none; }\n    body[data-active=\"s5\"] .scroll-nav a { mix-blend-mode: normal; }\n    .deck-logo .logo-dot {\n      width: 24px; height: 24px;\n      border-radius: 50%;\n      background: linear-gradient(135deg, var(--lavender), var(--pink) 60%, var(--yellow));\n      position: relative;\n      flex-shrink: 0;\n    }\n    .deck-logo .logo-dot::after {\n      content: \"\";\n      position: absolute;\n      inset: 7px;\n      background: var(--bg);\n      border-radius: 50%;\n    }\n\n    /* Scroll progress dots */\n    .scroll-nav {\n      position: fixed;\n      right: 28px;\n      top: 50%;\n      transform: translateY(-50%);\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      z-index: 50;\n    }\n    .scroll-nav a {\n      width: 8px; height: 8px;\n      border-radius: 50%;\n      background: rgba(20, 16, 28, 0.18);\n      transition: all 0.2s;\n      display: block;\n      position: relative;\n    }\n    .scroll-nav a::after {\n      content: attr(data-label);\n      position: absolute;\n      right: 16px;\n      top: 50%;\n      transform: translateY(-50%);\n      font-family: var(--font-mono);\n      font-size: 10px;\n      color: var(--text-dim);\n      letter-spacing: 0.05em;\n      text-transform: uppercase;\n      white-space: nowrap;\n      opacity: 0;\n      transition: opacity 0.2s;\n      pointer-events: none;\n    }\n    .scroll-nav a:hover::after { opacity: 1; }\n    .scroll-nav a.active { background: var(--lavender); transform: scale(1.4); }\n\n    .section-meta {\n      font-family: var(--font-mono);\n      font-size: 10.5px;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--text-faint);\n      margin-bottom: 14px;\n      display: flex;\n      align-items: center;\n      gap: 14px;\n    }\n    .section-meta::before {\n      content: \"\";\n      display: inline-block;\n      width: 36px; height: 1px;\n      background: currentColor;\n      opacity: 0.5;\n    }\n    .section-meta .step {\n      display: inline-grid; place-items: center;\n      width: 24px; height: 24px;\n      background: var(--text);\n      color: var(--bg);\n      border-radius: 50%;\n      font-weight: 700;\n      font-size: 11px;\n    }\n\n    /* Scroll hint */\n    .scroll-hint {\n      position: absolute;\n      bottom: 18px;\n      left: 50%;\n      transform: translateX(-50%);\n      font-family: var(--font-mono);\n      font-size: 10px;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      color: var(--text-dim);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 6px;\n      animation: bob 2.5s infinite;\n    }\n    @keyframes bob {\n      0%, 100% { transform: translate(-50%, 0); opacity: 0.8; }\n      50% { transform: translate(-50%, 6px); opacity: 1; }\n    }\n    .scroll-hint .arrow {\n      width: 14px; height: 14px;\n      border-right: 1.5px solid currentColor;\n      border-bottom: 1.5px solid currentColor;\n      transform: rotate(45deg);\n      margin-top: -8px;\n    }\n\n    /* ============ SECTION 1 — Pitch ============ */\n    .pitch {\n      background: var(--bg);\n    }\n    .pitch-head {\n      max-width: 1100px;\n      margin-bottom: 12px;\n    }\n    /* Reserve room for the deck-logo at top */\n    .pitch-head {\n      max-width: 1400px;\n      width: 100%;\n      margin: 0 auto;\n      margin-bottom: 8px;\n      padding-left: 200px;\n    }\n    .pitch-title {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: clamp(40px, 4.4vw, 64px);\n      letter-spacing: -0.035em;\n      line-height: 0.98;\n      margin: 0 0 14px;\n      text-wrap: balance;\n    }\n    .pitch-title em {\n      font-family: var(--font-serif);\n      font-weight: 400;\n      font-style: italic;\n      color: var(--lavender);\n    }\n    .pitch-sub {\n      font-size: 17px;\n      color: var(--text-dim);\n      line-height: 1.45;\n      max-width: 820px;\n      margin: 0;\n      text-wrap: pretty;\n    }\n\n    .pitch-grid {\n      flex: 1;\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 16px;\n      margin: 18px auto 0;\n      min-height: 0;\n      width: 100%;\n      max-width: 1400px;\n      max-height: 500px;\n      align-self: center;\n    }\n    .pitch-card {\n      background: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 22px;\n      padding: 24px 22px;\n      display: flex;\n      flex-direction: column;\n      gap: 14px;\n      position: relative;\n      overflow: hidden;\n      transition: transform 0.2s, box-shadow 0.2s;\n      min-width: 0;\n      min-height: 0;\n      justify-content: flex-start;\n    }\n    .pitch-card::before {\n      content: \"\";\n      position: absolute;\n      inset: 0 0 auto 0;\n      height: 5px;\n    }\n    .pitch-card.problem::before { background: var(--pink); }\n    .pitch-card.solution::before { background: var(--lavender); }\n    .pitch-card.market::before { background: var(--green); }\n    .pitch-card.win::before { background: var(--yellow); }\n    .pitch-card:hover { transform: translateY(-4px); box-shadow: 0 22px 50px -18px rgba(20, 16, 28, 0.14); }\n\n    .pitch-card .card-num {\n      font-family: var(--font-mono);\n      font-size: 11px;\n      letter-spacing: 0.14em;\n      color: var(--text-faint);\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      text-transform: uppercase;\n    }\n    .pitch-card .card-num span {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 32px;\n      letter-spacing: -0.03em;\n      color: var(--text);\n      line-height: 1;\n    }\n    .pitch-card.problem .card-num span { color: var(--pink); }\n    .pitch-card.solution .card-num span { color: var(--lavender); }\n    .pitch-card.market .card-num span { color: var(--green); }\n    .pitch-card.win .card-num span { color: #B45309; }\n\n    .pitch-card h3 {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 30px;\n      letter-spacing: -0.028em;\n      margin: 0;\n      line-height: 0.98;\n      color: var(--text);\n      text-wrap: balance;\n    }\n    .pitch-card p {\n      font-size: 15px;\n      color: var(--text-dim);\n      line-height: 1.48;\n      margin: 0;\n      text-wrap: pretty;\n    }\n    .pitch-card .body-lg {\n      font-size: 16px;\n      color: var(--text);\n    }\n    .pitch-card ul {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .pitch-card li {\n      font-size: 17px;\n      font-weight: 600;\n      color: var(--text);\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      letter-spacing: -0.01em;\n    }\n    .pitch-card li .check {\n      width: 24px; height: 24px;\n      border-radius: 50%;\n      background: rgba(139, 92, 246, 0.14);\n      color: var(--lavender);\n      display: grid; place-items: center;\n      font-weight: 700;\n      font-size: 12px;\n      flex-shrink: 0;\n    }\n\n    /* Big hero stat */\n    .hero-stat {\n      margin: 4px 0;\n    }\n    .hero-stat .big {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: clamp(56px, 4.6vw, 80px);\n      letter-spacing: -0.04em;\n      line-height: 0.88;\n      color: var(--green);\n      display: block;\n    }\n    .hero-stat .big-sub {\n      font-size: 14px;\n      color: var(--text-dim);\n      margin-top: 6px;\n      font-weight: 500;\n    }\n    .stat-row {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      margin-top: auto;\n      padding-top: 16px;\n      border-top: 1px solid var(--border);\n    }\n    .stat-row .stat {\n      display: flex;\n      align-items: baseline;\n      gap: 14px;\n    }\n    .stat-row .stat .num {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 21px;\n      letter-spacing: -0.02em;\n      color: var(--text);\n      min-width: 84px;\n    }\n    .stat-row .stat .lbl {\n      font-size: 13px;\n      color: var(--text-dim);\n    }\n\n    /* Trio block */\n    .trio {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 8px;\n      margin: 4px 0;\n    }\n    .trio-item {\n      background: var(--bg-elev);\n      border-radius: 12px;\n      padding: 16px 10px;\n      text-align: center;\n    }\n    .trio-item .verb {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 20px;\n      letter-spacing: -0.025em;\n      color: var(--text);\n      display: block;\n      line-height: 1;\n    }\n    .trio-item.lav .verb { color: var(--lavender); }\n    .trio-item.pnk .verb { color: var(--pink); }\n    .trio-item.yel .verb { color: #B45309; }\n    .trio-item .tag {\n      font-family: var(--font-mono);\n      font-size: 9.5px;\n      letter-spacing: 0.08em;\n      color: var(--text-faint);\n      margin-top: 6px;\n    }\n\n    .fragment-chips {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 7px;\n      margin-top: auto;\n      padding-top: 8px;\n    }\n    .frag-chip {\n      font-family: var(--font-mono);\n      font-size: 12px;\n      background: var(--bg-elev);\n      color: var(--text-dim);\n      padding: 6px 11px;\n      border-radius: 999px;\n      text-decoration: line-through;\n      text-decoration-color: rgba(233, 30, 99, 0.55);\n      text-decoration-thickness: 1.5px;\n    }\n\n    /* ============ SECTION 2 — Personas ============ */\n    .personas {\n      background: linear-gradient(180deg, var(--bg) 0%, var(--bg-elev) 100%);\n    }\n    .personas-grid {\n      flex: 1;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n      margin: 18px auto 0;\n      min-height: 0;\n      width: 100%;\n      max-width: 1400px;\n      max-height: 640px;\n      align-self: center;\n    }\n    .persona {\n      border: 1px solid rgba(80, 60, 130, 0.1);\n      border-radius: 26px;\n      padding: 26px 26px;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n      position: relative;\n      overflow: hidden;\n      min-width: 0;\n      min-height: 0;\n      transition: transform 0.2s, box-shadow 0.2s;\n      color: #2A2240;\n      isolation: isolate;\n    }\n    .persona:hover { transform: translateY(-4px); box-shadow: 0 28px 60px -20px rgba(80, 60, 130, 0.25); }\n\n    /* Solid soft lavender background for all three personas */\n    .persona.iris,\n    .persona.luca,\n    .persona.marco {\n      background: #E9E3F7;\n    }\n\n    /* Decorative gloss */\n    .persona::after {\n      content: \"\";\n      position: absolute;\n      top: -100px; right: -80px;\n      width: 320px; height: 320px;\n      border-radius: 50%;\n      filter: blur(60px);\n      opacity: 0.55;\n      z-index: -1;\n      background: #FFFFFF;\n    }\n\n    .persona-top {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n    }\n    .persona-avatar {\n      width: 92px; height: 92px;\n      border-radius: 50%;\n      overflow: hidden;\n      position: relative;\n      flex-shrink: 0;\n      background: rgba(255,255,255,0.4);\n      border: 3px solid #fff;\n      box-shadow: 0 10px 24px -8px rgba(80, 60, 130, 0.3);\n    }\n    .persona-avatar img {\n      width: 100%; height: 100%; object-fit: cover; display: block;\n    }\n    .persona-id .name {\n      font-family: var(--font-display);\n      font-weight: 800;\n      font-size: 48px;\n      letter-spacing: -0.035em;\n      line-height: 0.9;\n      margin: 0;\n      color: #2A2240;\n    }\n    .persona-id .age {\n      font-family: var(--font-mono);\n      font-size: 12px;\n      color: rgba(42, 34, 64, 0.65);\n      margin-top: 8px;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n    }\n    .persona-tag {\n      display: inline-flex; align-items: center; gap: 8px;\n      font-family: var(--font-display);\n      font-weight: 700;\n      font-size: 15px;\n      padding: 8px 16px;\n      border-radius: 999px;\n      width: fit-content;\n      letter-spacing: -0.01em;\n      background: rgba(255, 255, 255, 0.55);\n      backdrop-filter: blur(8px);\n      color: #4B3E80;\n      border: 1px solid rgba(255, 255, 255, 0.5);\n    }\n\n    .persona-profile {\n      font-size: 16px;\n      color: rgba(42, 34, 64, 0.82);\n      line-height: 1.45;\n      margin: 0;\n      text-wrap: pretty;\n      font-weight: 400;\n    }\n    .persona-profile strong { color: #2A2240; font-weight: 700; }\n\n    /* \"What they want\" mini list */\n    .persona-wants {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      padding: 14px 0;\n      border-top: 1px solid rgba(80, 60, 130, 0.18);\n      border-bottom: 1px solid rgba(80, 60, 130, 0.18);\n    }\n    .persona-wants .wants-label {\n      font-family: var(--font-mono);\n      font-size: 10.5px;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: rgba(42, 34, 64, 0.55);\n    }\n    .persona-wants .want-row {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      font-size: 15px;\n      font-weight: 600;\n      color: #2A2240;\n      line-height: 1.25